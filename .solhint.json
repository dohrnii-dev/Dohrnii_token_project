{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": [
      "error",
      "0.8.36"
    ],
    "func-visibility": [
      "error",
      {
        "ignoreConstructors": true
      }
    ],
    "max-line-length": [
      "error",
      120
    ],
    "named-parameters-mapping": "off",
    "no-empty-blocks": "warn",
    "ordering": "off",
    "gas-custom-errors": "error",
    "reason-string": "off",
    "foundry-test-functions": "off",
    "use-natspec": [
      "warn",
      {
        "author": {
          "enabled": false
        }
      }
    ],
    "gas-indexed-events": "off"
  }
}

{
  "name": "dohrnii-token",
  "version": "1.0.0",
  "description": "DHN — Dohrnii ERC-20 token (UUPS upgradeable, ERC-7201 namespaced storage)",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test mocha",
    "build": "hardhat build",
    "compile": "hardhat build",
    "coverage": "hardhat test mocha --coverage",
    "lint": "solhint 'contracts/**/*.sol' --max-warnings 0",

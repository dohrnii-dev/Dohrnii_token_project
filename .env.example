# Copy to .env and fill in. Never commit .env.
#
# Hardhat 3 reads these through `configVariable(...)` in hardhat.config.ts. For mainnet you can
# keep the deployer key out of files entirely and use the encrypted keystore instead:
#   npx hardhat keystore set DEPLOYER_PRIVATE_KEY

# --- RPC endpoints ---
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>

# --- Deployer (pays gas only; holds no privileges after deployment) ---
DEPLOYER_PRIVATE_KEY=0x

# --- Etherscan verification ---
ETHERSCAN_API_KEY=

# --- Deployment parameters (scripts/deploy.ts) ---
# Wallet that becomes owner()/default admin and receives every role.
OWNER_ADDRESS=0x
# Wallet that receives all 372,000,000 DHN. Defaults to OWNER_ADDRESS when unset.
SUPPLY_RECIPIENT_ADDRESS=0x
# Delay, in seconds, enforced on a future ownership transfer. Default 10800 (3 hours).
# Seconds, not milliseconds. Capped at 604800 (7 days) by the contract; 0 disables the
# cancellation window entirely, leaving only the nominee's explicit acceptance.
ADMIN_DELAY_SECONDS=10800


# --- Upgrade parameters (scripts/upgrade.ts) ---
PROXY_ADDRESS=0x
NEW_IMPLEMENTATION_CONTRACT=DohrniiTokenV2
# true = deploy + validate the new implementation only, leaving the proxy untouched
PREPARE_ONLY=false
